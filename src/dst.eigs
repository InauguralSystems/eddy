# eddy — milestone 1 CLI: a single-register store as a cooperative-task DST.
#
# The machinery lives in src/dst_core.eigs (issue #6 split — the
# interleaving explorer runs the same core in-process); this file is the
# unchanged CLI contract:
#
#   Usage: eigenscript src/dst.eigs SEED MODE   (MODE = "correct" | "torn")
#
# Emits the JSON history for the EXTERNAL linearizability checker
# (Porcupine) to grade — the store never grades itself. Output is
# byte-identical to the pre-split script (gated against the explorer's
# --dump in test/run_ui.sh).
load_file of "src/dst_core.eigs"

argv is args of null
r is dst_run of [num of argv[0], argv[1], 0]
print of (json_encode of (r.events))
